# Climate Change Data Analysis Platform
# Environment Configuration Template

# ============================================
# PROJECT SETTINGS
# ============================================
PROJECT_NAME=climate_analysis
PROJECT_VERSION=1.0.0
ENVIRONMENT=development

# ============================================
# DATA PATHS
# ============================================
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_SAMPLE_DIR=./data/sample
MODEL_DIR=./pipeline/ml/models
VISUALIZATION_OUTPUT_DIR=./visualizations/output

# ============================================
# API CREDENTIALS (if needed)
# ============================================
# NASA_API_KEY=your_api_key_here
# NOAA_API_KEY=your_api_key_here

# ============================================
# KAFKA SETTINGS
# ============================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TEMPERATURE=climate.temperature
KAFKA_TOPIC_CO2=climate.co2
KAFKA_TOPIC_METHANE=climate.methane
KAFKA_TOPIC_SEALEVEL=climate.sealevel

# ============================================
# AIRFLOW SETTINGS
# ============================================
AIRFLOW_HOME=~/airflow
AIRFLOW_DAGS_FOLDER=~/airflow/dags
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__SQL_ALCHEMY_CONN=sqlite:///~/airflow/airflow.db
AIRFLOW__CORE__LOAD_EXAMPLES=False

# ============================================
# DATABASE SETTINGS (Optional)
# ============================================
DATABASE_TYPE=sqlite
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=climate_db
DATABASE_USER=climate_user
# DATABASE_PASSWORD=your_password_here

# ============================================
# AWS S3 SETTINGS (Optional)
# ============================================
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_S3_BUCKET=climate-data-bucket
# AWS_REGION=us-east-1

# ============================================
# ML MODEL SETTINGS
# ============================================
ML_TRAIN_TEST_SPLIT=0.2
ML_RANDOM_STATE=42
ML_FORECAST_YEARS=30
ML_CONFIDENCE_LEVEL=0.95

# ============================================
# VISUALIZATION SETTINGS
# ============================================
VIZ_FIGURE_DPI=300
VIZ_FIGURE_SIZE=12,8
VIZ_THEME=plotly_white

# ============================================
# WEB SERVER SETTINGS
# ============================================
WEB_HOST=localhost
WEB_PORT=8000
WEB_DEBUG=True

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_FILE=./logs/climate_analysis.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ============================================
# EMAIL NOTIFICATIONS (Optional)
# ============================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# ALERT_EMAIL=climate-alerts@example.com
