# Climate Analysis - Python Gitignore

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Jupyter Notebook
.ipynb_checkpoints

# Environment
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Project specific
/data/raw/*
/data/processed/*
!/data/sample/
/pipeline/ml/models/*.pkl
/visualizations/output/*.html
/visualizations/output/*.png
/logs/
*.log

# Airflow
airflow.cfg
airflow.db
airflow-webserver.pid
unittests.cfg

# Kafka
/kafka-logs/
/zookeeper/

# Temporary files
*.tmp
*.temp
.temp/
